# Local development only. Generate fresh random values before running the API.
DATABASE_URL=postgres://orders_test:local-only@127.0.0.1:5433/orders_test
ORDERS_API_SECRET=
CRON_SECRET=
NODEJS_HELPERS=0

# Optional Stripe sandbox checkout. Omit these for credential-free simulation.
# Never paste live keys here. Keep actual values in an ignored environment file.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STOREFRONT_ORIGIN=http://127.0.0.1:3000
# Loopback only; rejected on Vercel. Use a fixed HTTPS origin when deployed.
ORDERS_ALLOW_LOCAL_STOREFRONT=true

# Optional private merchant inbox. OAuth and session secrets stay in this service.
# Register a GitHub OAuth App with the storefront callback:
# https://<storefront-origin>/api/auth/callback/github
MERCHANT_AUTH_ENABLED=false
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated immutable numeric GitHub account IDs, never emails/usernames.
MERCHANT_GITHUB_IDS=
# Loopback only and always rejected on Vercel.
MERCHANT_ALLOW_LOCAL_AUTH=true
